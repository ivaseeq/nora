{
  "name": "nora-e2e",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:functional": "npx playwright test --project=chromium-fullhd --project=firefox-functional --project=webkit-functional",
    "test:responsive": "npx playwright test --project=chromium-1536 --project=chromium-mobile-390 --project=chromium-landscape-844 --project=chromium-reflow-320",
    "test:smoke:local": "bash scripts/run-local-ui-smoke.sh",
    "test:visual": "npx playwright test --project=visual-chromium-fullhd",
    "test:list": "npx playwright test --list",
    "test:headed": "npx playwright test --project=chromium-fullhd --headed",
    "test:ui": "npx playwright test --ui",
    "test:protocol:write": "npx playwright test --config=playwright.protocol.config.ts",
    "build:css": "tailwindcss -c tailwind.config.cjs -i input.css -o ../../nora-registry/src/ui/static/tailwind.css --minify",
    "check:css": "node scripts/check-css.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "tailwindcss": "3.4.17"
  }
}
